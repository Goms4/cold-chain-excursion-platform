# Database Configuration
POSTGRES_DB=cold_chain
COLDCHAIN_ADMIN_PASSWORD=replace-with-local-admin-secret
COLDCHAIN_MIGRATOR_PASSWORD=replace-with-local-migrator-secret
COLDCHAIN_APP_PASSWORD=replace-with-local-app-secret

# Demo-only local credentials. Production profiles must provide distinct secrets.
COLDLATCH_OPERATIONS_PASSWORD=Ops-Demo-2026
COLDLATCH_ANALYST_PASSWORD=Analyst-Demo-2026
COLDLATCH_FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Optional Cloud Analytical Warehouse (Snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=COLD_CHAIN_DW
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
